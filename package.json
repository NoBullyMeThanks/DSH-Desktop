{
  "name": "dsh-desktop",
  "version": "1.0.3",
  "description": "默认跟随 DeepSeek 官方最新版的 DSH 桌面启动器",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "DSH Desktop",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis portable",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deepseek.dsh-desktop",
    "productName": "DSH-Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "runtime-manager.js",
      "runtime-operation-lock.js",
      "update-preferences.js",
      "settings-reader.js",
      "tray.js",
      "i18n.js",
      "stall-diagnostics.js",
      "startup-layout.js",
      "content-preload.js",
      "startup.html",
      "startup-preload.js",
      "assets/deepseek-official-fish-black.svg",
      "assets/icon.ico",
      "assets/icon.png",
      "assets/tray.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH-Desktop",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "semver": "^7.8.5"
  }
}
